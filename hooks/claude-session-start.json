{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\" || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/needs-node.json\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
